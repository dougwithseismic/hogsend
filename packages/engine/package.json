{
  "name": "@hogsend/engine",
  "version": "0.68.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dougwithseismic/hogsend.git",
    "directory": "packages/engine"
  },
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@hogsend/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./worker": {
      "@hogsend/source": "./src/worker.ts",
      "types": "./dist/worker.d.ts",
      "default": "./src/worker.ts"
    },
    "./auth": {
      "@hogsend/source": "./src/lib/auth.ts",
      "types": "./dist/lib/auth.d.ts",
      "default": "./src/lib/auth.ts"
    },
    "./create-admin": {
      "@hogsend/source": "./src/lib/create-admin.ts",
      "types": "./dist/lib/create-admin.d.ts",
      "default": "./src/lib/create-admin.ts"
    },
    "./api-key-hash": {
      "@hogsend/source": "./src/lib/api-key-hash.ts",
      "types": "./dist/lib/api-key-hash.d.ts",
      "default": "./src/lib/api-key-hash.ts"
    },
    "./posthog-scopes": {
      "@hogsend/source": "./src/lib/posthog-scopes.ts",
      "types": "./dist/lib/posthog-scopes.d.ts",
      "default": "./src/lib/posthog-scopes.ts"
    },
    "./journeys": {
      "@hogsend/source": "./src/journeys/authoring.ts",
      "types": "./dist/journeys/authoring.d.ts",
      "default": "./src/journeys/authoring.ts"
    },
    "./testing": {
      "@hogsend/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./src/testing.ts"
    },
    "./mcp/authoring-guide": {
      "@hogsend/source": "./src/mcp/authoring-guide.ts",
      "types": "./dist/mcp/authoring-guide.d.ts",
      "default": "./src/mcp/authoring-guide.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "lint": "biome check .",
    "clean": "rm -rf node_modules .turbo",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hatchet-dev/typescript-sdk": "^1.22.3",
    "@hogsend/attribution": "workspace:^",
    "@hogsend/core": "workspace:^",
    "@hogsend/db": "workspace:^",
    "@hogsend/email": "workspace:^",
    "@hogsend/plugin-posthog": "workspace:^",
    "@hogsend/plugin-resend": "workspace:^",
    "@hogsend/sms": "workspace:^",
    "@hono/node-server": "^2.0.4",
    "@hono/zod-openapi": "1.4.0",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@scalar/hono-api-reference": "^0.10.19",
    "@t3-oss/env-core": "^0.13.11",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "ai": "^6.0.209",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.22",
    "ioredis": "^5.10.1",
    "launch-editor": "^2.14.1",
    "papaparse": "^5.5.3",
    "picocolors": "^1.1.1",
    "qrcode": "^1.5.4",
    "resend": "^6.12.3",
    "svix": "^1.95.1",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@hogsend/plugin-apollo": "workspace:^",
    "@hogsend/plugin-hogsend": "workspace:^",
    "@hogsend/plugin-postmark": "workspace:^",
    "@hogsend/plugin-twilio": "workspace:^"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "tsx": "^4.22.3"
  },
  "engines": {
    "node": ">=22"
  }
}
