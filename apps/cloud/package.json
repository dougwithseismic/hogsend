{
  "name": "@hogsend/cloud",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "SKIP_ENV_VALIDATION=true next build",
    "start": "next start -p 3004",
    "check-types": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "build:default-image": "tsx scripts/build-default-image.ts",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "ses:walkthrough": "tsx diagnostics/ses-walkthrough.ts",
    "ses:delivery-proof": "tsx diagnostics/ses-delivery-proof.ts",
    "diagnostics:test": "vitest run --config diagnostics/vitest.config.ts",
    "diagnostics:check-types": "tsc --noEmit -p diagnostics/tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/client-ses": "^3.1106.0",
    "@aws-sdk/client-sesv2": "^3.1106.0",
    "@aws-sdk/client-sns": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@hatchet-dev/typescript-sdk": "^1.28.0",
    "@hogsend/plugin-hogsend": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "next": "^16.2.12",
    "postal-mime": "^2.7.6",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
